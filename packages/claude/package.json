{
  "name": "@toragonite/agent-mesh-claude",
  "version": "0.1.1",
  "description": "Claude Code adapter for agent-mesh — drive the official `claude` CLI as a headless worker (run / resume / stream / quota / auth), plus the absorbed claude-mesh background-agent, gateway, and bridge layers. Unofficial.",
  "keywords": ["ai","agent","orchestration","claude","claude-code","anthropic","adapter","background-agents","mesh","cli"],
  "license": "MIT",
  "author": "Toragonite",
  "type": "module",
  "engines": { "node": ">=18.17" },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }
  },
  "bin": { "agent-mesh-claude": "./dist/cli.js" },
  "files": ["dist"],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Toragonite/agent-mesh.git",
    "directory": "packages/claude"
  },
  "homepage": "https://toragonite.github.io/agent-mesh/",
  "bugs": "https://github.com/Toragonite/agent-mesh/issues",
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "tsup"
  },
  "dependencies": {
    "@toragonite/agent-mesh": "^0.1.0"
  }
}
